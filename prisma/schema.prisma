generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TENANT
  LANDLORD
}

enum ApplicationStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  VERIFYING
  ZK_VERIFIED
  ZK_REJECTED
  LEASE_OFFERED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum RevealStatus {
  NONE
  REQUESTED
  GRANTED
  DECLINED
}

model User {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role           UserRole
  email          String        @unique
  displayName    String?
  passwordHash   String?
  authProvider   String?
  authProviderId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  properties     Property[]
  applications   Application[]
  payments       Payment[]

  @@unique([authProvider, authProviderId])
  @@map("users")
}

model Property {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  address           String
  city              String
  state             String
  zip               String
  price             Int
  beds              Int
  baths             Float
  sqft              Int
  type              String
  description       String
  images            String[]      @default([])
  amenities         String[]      @default([])
  status            String        @default("active")
  minIncome         Int           @default(75000)
  requireBackground Boolean       @default(true)
  requireEmployment Boolean       @default(true)
  verificationFee   Float         @default(5.0)
  maxRentToIncomeRatioBps Int     @default(3300)
  minCreditScore    Int           @default(650)
  minEmploymentMonths Int         @default(12)
  primeMinIncomeRatioBps Int      @default(2500)
  primeMinCreditScore Int         @default(750)
  criteriaHash      String?
  criteriaVersion   Int           @default(1)
  landlordId        String        @db.Uuid
  landlord          User          @relation(fields: [landlordId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  applications      Application[]

  @@map("properties")
}

model Application {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicantDisplayId String
  propertyId         String             @db.Uuid
  property           Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId           String             @db.Uuid
  tenant             User               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status             ApplicationStatus  @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus      @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING)
  revealStatus       RevealStatus       @default(NONE)
  revealRequestedAt  DateTime?
  revealGrantedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  payments           Payment[]
  verifications      Verification[]

  @@unique([propertyId, tenantId])
  @@map("applications")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId         String        @db.Uuid
  application           Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId                String        @db.Uuid
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                Float
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  transactionId         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt

  @@map("payments")
}

model Verification {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String             @db.Uuid
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        VerificationStatus @default(PENDING)
  isEligible    Boolean            @default(false)
  proofHash     String?
  midnightTx    String?
  circuitId     String?
  merkleRoot    String?
  blockHeight   Int?
  provingTimeMs Int?
  tier          Int                @default(0)
  nullifier     String?
  criteriaHash  String?
  expiresAt     DateTime?
  lifecycle     String             @default("Active")
  verifiedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  @@map("verifications")
}
